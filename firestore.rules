rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net: Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    match /test/{document=**} {
      allow read: if true;
    }

    // ===============================================================
    // Reusable Global Helpers
    // ===============================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && 
        'email' in request.auth.token && 
        (request.auth.token.email == "statuslovey@gmail.com" || request.auth.token.email == "sodoom@google.com");
    }

    function isValidId(id) {
      return id is string && id.size() <= 256;
    }

    // ===============================================================
    // Entity Schema Validation
    // ===============================================================
    function isValidUserProfile(data) {
      return data.uid is string &&
             data.displayName is string &&
             data.membershipId is string &&
             data.fatherName is string &&
             data.phone is string &&
             data.email is string &&
             data.isStudent is bool &&
             (data.unpaidInstallments is int || data.unpaidInstallments is float) &&
             data.eligibilityChecked is bool &&
             data.joinedAt is string &&
             (!('avatarUrl' in data) || (data.avatarUrl is string)) &&
             (!('ledgerItems' in data) || data.ledgerItems is list) &&
             (!('claimsList' in data) || data.claimsList is list);
    }

    // ===============================================================
    // Malani Seva Sanstha Directory Rules
    // ===============================================================
    match /users/{userId} {
      allow read, write: if isSignedIn();
    }
  }
}
